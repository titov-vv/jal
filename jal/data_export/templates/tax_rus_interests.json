      [null, null, "ИТОГО", "amount", "amount_rub", "tax2pay", null]
    ],
    "formats": [
      [null, null, "F", "F", "F", "Fe", null]
    ]
  },
  "footers": [
    "Описание данных в столбцах таблицы",
    "1 - Описание платежа",
    "2 - Дата платежа",
    "3 - Официальный курс валюты,  установленный ЦБ РФ на дату платежа",
    "4 - Сумма платежа в валюте счёта",
    "5 - Сумма дохода в рублях (= Столбец 3 * Столбец 4)",
    "6 - Базовая оценка налога к уплате (базовая ставка от столбца 5)"
  ]
